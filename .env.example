# ── Modo Mock (sem banco de dados) ────────────────────
# true  = dados ficticios, sem MySQL
# false = conexao real com MySQL abaixo
MOCK_MODE=true

# ── Banco de Dados MySQL (ignorado se MOCK_MODE=true) ─
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=seu_banco

# ── JWT ───────────────────────────────────────────────
SECRET_KEY=dev-secret-troque-em-producao-use-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Usuarios ──────────────────────────────────────────
# Hash da senha "admin123" gerado com: uv run hash_password.py
USERS_JSON=[{"username":"admin","password_hash":"$2b$12$eImiTXuWVxfM37uY4JANjQ==.PLACEHOLDER","role":"admin"}]
