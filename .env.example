# ── Modo Mock (sem banco de dados) ────────────────────
# true  = dados ficticios, sem MySQL
# false = conexao real com MySQL abaixo
MOCK_MODE=true

# ── Banco de Dados MySQL (ignorado se MOCK_MODE=true) ─
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=seu_banco

# ── JWT ───────────────────────────────────────────────
SECRET_KEY=TrbIti7olFNWrYvCaYv8kXL3ycjmKYCeJ5Aie0ZWhAL
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Usuarios (SQLite) ─────────────────────────────────
# Caminho do arquivo SQLite que guarda os usuarios.
# Use o CLI para criar/atualizar usuarios:
#   uv run manage_users.py create admin --role admin
USERS_DB_PATH=users.db
